{
  "name": "artsbyas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npx esbuild src/worker.ts --bundle --format=esm --outfile=dist/_worker.js",
    "build:admin": "tsc -b && vite build --config vite.admin.config.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name=artbyas-ecommerce"
  },
  "dependencies": {
    "framer-motion": "^13.1.0",
    "hono": "^4.13.2",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "esbuild": "^0.20.0",
    "wrangler": "^4.123.0"
  }
}
